# Demo is explicit. Never deploy demo identities on an enterprise network.
AEGIS_MODE=demo
AEGIS_SIGNING_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
AEGIS_DATABASE_URL=sqlite:///./aegis-demo.db
AEGIS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AEGIS_TOKEN_MINUTES=15
# Required by infrastructure profile, values generated by scripts/setup.py.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_VALUE
MINIO_ROOT_USER=aegis-local
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_VALUE
# Real CA/Gateway configuration is not yet implemented. Do not add browser secrets.
