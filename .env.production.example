# Copy to .env.production and provision values through your secret manager.
AEGIS_MODE=production
AEGIS_MALWARE_HOST=malware
AEGIS_MALWARE_PORT=3310
AEGIS_SIGNING_SECRET=REPLACE_WITH_RANDOM_SESSION_SIGNING_SECRET
AEGIS_DATABASE_URL=postgresql+psycopg://aegis_app:REPLACE_DB_PASSWORD@postgres:5432/aegis?sslmode=verify-full&sslrootcert=/run/tls/ca.crt
AEGIS_ALLOWED_ORIGINS=["https://REPLACE_PUBLIC_HOST"]
AEGIS_TOKEN_MINUTES=15
AEGIS_REDIS_URL=rediss://:REPLACE_REDIS_PASSWORD@redis:6379/0?ssl_ca_certs=/run/tls/ca.crt
AEGIS_FABRIC_URL=https://bridge:8443
AEGIS_FABRIC_TOKEN=REPLACE_WITH_RANDOM_BRIDGE_SERVICE_TOKEN
AEGIS_FABRIC_CA_BUNDLE=/run/tls/ca.crt
AEGIS_S3_ENDPOINT=https://objects:9000
AEGIS_S3_REGION=us-east-1
AEGIS_S3_BUCKET=aegis-evidence
AEGIS_S3_ACCESS_KEY=REPLACE_APP_OBJECT_ACCESS_KEY
AEGIS_S3_SECRET_KEY=REPLACE_APP_OBJECT_SECRET_KEY
AEGIS_S3_KMS_KEY=REPLACE_EXISTING_KMS_KEY_ID
AEGIS_CREDENTIAL_PRIVATE_KEY=/run/keys/vc-private.pem
AEGIS_CREDENTIAL_KEY_ID=REPLACE_ISSUER_KEY_ID
AEGIS_CREDENTIAL_PUBLIC_KEYS={"REPLACE_ISSUER_KEY_ID":"REPLACE_PUBLIC_PEM_WITH_ESCAPED_NEWLINES"}
POSTGRES_PASSWORD=REPLACE_DDL_OWNER_PASSWORD
AEGIS_DB_PASSWORD=REPLACE_DB_PASSWORD
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
MINIO_ROOT_USER=REPLACE_OBJECT_ADMIN
MINIO_ROOT_PASSWORD=REPLACE_OBJECT_ADMIN_SECRET
# MinIO SSE-KMS requires a separately managed KMS/KES service; see DEPLOYMENT.md.
MINIO_KMS_KES_ENDPOINT=https://REPLACE_KES_ENDPOINT
MINIO_KMS_KES_KEY_FILE=/run/keys/kes-client.key
MINIO_KMS_KES_CERT_FILE=/run/keys/kes-client.crt
MINIO_KMS_KES_CAPATH=/run/tls/ca.crt
MINIO_KMS_KES_KEY_NAME=REPLACE_EXISTING_KMS_KEY_ID
AEGIS_PROFILE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
WALLET_KEY=REPLACE_WITH_64_HEX_CHARACTERS
FABRIC_DOCKER_NETWORK=REPLACE_FABRIC_NETWORK
FABRIC_EVENT_IDENTITY=REPLACE_BOOTSTRAPPED_EVENT_DID
